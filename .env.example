# Copy this file to .env.local and fill it in. Never commit .env.local or any real key.

# --- The site (read by the browser and the Next.js server; set the same two in Vercel) ---

# The address of your Supabase project: Supabase > Project Settings > API > Project URL.
# Public: it is sent to every visitor's browser. Without it the site runs with no database (empty lists, log in switched off).
NEXT_PUBLIC_SUPABASE_URL=

# The project's publishable (anon) key: Supabase > Project Settings > API Keys. Public too; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Tests (optional) ---

# The address the Playwright smoke tests open (npm run test:e2e). Defaults to http://localhost:3100.
# E2E_BASE_URL=https://collex.au

# --- Not set here: these live in Supabase and GitHub, listed so they are not forgotten ---
# RESEND_API_KEY    Supabase > Edge Functions > Secrets. Read by the mailer, notify and chamber-invite functions to send email.
# SUPABASE_DB_URL   Provided to every edge function by Supabase itself; nothing to set.
# SUPABASE_DB_URL   (GitHub secret, a different value) The database connection string the nightly backup uses. See docs/backups.md.
# BACKUP_PASSPHRASE (GitHub secret) Encrypts the nightly backup. See docs/backups.md.
